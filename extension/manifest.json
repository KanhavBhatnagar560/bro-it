{
  "manifest_version": 3,
  "name": "Bro It",
  "version": "0.1.0",
  "description": "Explain highlighted text in simple language with Codex and GPT-5.6 Luna.",
  "key": "",
  "permissions": [
    "contextMenus",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
